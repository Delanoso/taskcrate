generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  fullName         String
  platformAdmin    Boolean  @default(false)
  sessionVersion   Int      @default(0)
  mustSetPassword  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships      Membership[]
  termsAcceptances TermsAcceptance[]
  notifications    Notification[]
  ipNoticeAcks     IpNoticeAcknowledgement[]
  supportTickets   SupportTicket[]
  supportReplies   SupportReply[]
  passwordResets   PasswordReset[]
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Organization {
  id         String    @id @default(cuid())
  name       String
  slug       String    @unique
  phone      String?
  phoneKey   String?
  companyKey String?
  trialEndsAt DateTime?
  trialNote  String?
  trialNoticeSent Boolean @default(false)
  trialReminderSent Boolean @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  branding       OrganizationBranding?
  departments    Department[]
  memberships    Membership[]
  subscriptions  Subscription[]
  trialClaims    TrialClaim[]
  documents      DocumentSequence[]
  notifications  Notification[]
  toolboxTalks   ToolboxTalk[]
  permits        WorkPermit[]
  visitorSites   VisitorSite[]
  assets         Asset[]
  nearMisses     NearMissReport[]
  nearMissBoard  NearMissBoard?
  contractors    ContractorProfile[]
  ohsaAudits     OhsaAudit[]
  leaveRequests  LeaveRequest[]
  leaveRules     LeaveLevelRule[]
  leaveEmployees LeaveEmployee[]
  leaveSettings  LeaveSettings?
  disciplineLogs DisciplineEntry[]
  disciplineSettings DisciplineSettings?
  onboardings    OnboardingPacket[]
  contracts      ContractDocument[]
  contractTemplates ContractTemplate[]
  equipmentItems EquipmentItem[]
  equipmentLogs  EquipmentCustodyLog[]
  equipmentIssues EquipmentIssue[]
  loanRecords    LoanDeductibleRecord[]
  jobCards       JobCard[]
  stockItems     StockItem[]
  vehicles       Vehicle[]
  meterSites     MeterSite[]
  obSites        ObSite[]
  fitSites       FitForDutySite[]
  supportTickets SupportTicket[]
  billingProfile    BillingProfile?
  billingTemplates  BillingTemplate[]
  billingDocuments  BillingDocument[]
  payrollProfile    PayrollProfile?
  payrollEmployees  PayrollEmployee[]
  payrollRuns       PayrollRun[]
  attendanceSites   AttendanceSite[]
  accidentReports   AccidentReport[]
  trainingTickets   TrainingTicket[]
}

model OrganizationBranding {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  displayName    String
  logoUrl        String?
  primaryColor   String       @default("#1e3a5f")
  accentColor    String       @default("#0ea5e9")
}

model Department {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  memberships    Membership[]

  @@unique([organizationId, name])
}

enum OrgRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           OrgRole      @default(MEMBER)
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id])
  productAccess  String?
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
}

model TermsAcceptance {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version    String
  acceptedAt DateTime @default(now())
}

model Subscription {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productSlug          String
  status               String       @default("active")
  currentPeriodEnd     DateTime?
  provider             String?
  payfastToken         String?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([organizationId, productSlug])
}

model TrialClaim {
  id             String       @id @default(cuid())
  kind           String
  value          String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([kind, value])
}

model DocumentSequence {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prefix         String       @default("DOC")
  nextNumber     Int          @default(1)

  @@unique([organizationId, prefix])
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])
  productSlug    String
  title          String
  body           String
  dueAt          DateTime?
  readAt         DateTime?
  createdAt      DateTime     @default(now())
}

model IpNoticeAcknowledgement {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productSlug    String
  version        String
  acknowledgedAt DateTime @default(now())

  @@unique([userId, productSlug, version])
}

model SupportTicket {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject        String
  body           String
  productSlug    String?
  status         String         @default("open")
  mailError      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  replies        SupportReply[]
}

model SupportReply {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime      @default(now())
}

// ——— Toolbox Talks ———
model ToolboxTalk {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  weekLabel      String
  content        String
  mediaUrl       String?
  /// Slug from the built-in talk library (src/data/toolbox-library)
  librarySlug    String?
  /// Uploaded PDF/image under /uploads/toolbox/<orgId>/, served via the public token
  attachmentUrl  String?
  attachmentName String?
  attachmentType String?
  publicToken    String              @unique @default(cuid())
  status         String              @default("open")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  attendances    ToolboxAttendance[]
}

model ToolboxAttendance {
  id            String      @id @default(cuid())
  talkId        String
  talk          ToolboxTalk @relation(fields: [talkId], references: [id], onDelete: Cascade)
  firstName     String
  lastName      String
  signatureData String
  signedAt      DateTime    @default(now())
  ipHash        String?

  @@index([talkId])
}

// ——— Permit to Work ———
model WorkPermit {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title            String
  publicToken      String       @unique @default(cuid())
  /// Permit Issuer: safety officer / manager authorizing the work
  issuerName       String?
  /// Permit Receiver: supervisor / contractor managing the tools
  contractorName   String?
  contractorPhone  String?
  specificLocation String?
  equipmentId      String?
  workDetails      String?
  startAt          DateTime?
  expiresAt        DateTime?
  /// JSON array of PERMIT_HAZARDS keys
  hazardsJson      String?
  lotoConfirmed       Boolean @default(false)
  barricadesConfirmed Boolean @default(false)
  fireExtinguisherOk  Boolean @default(false)
  /// JSON array of PERMIT_PRECAUTIONS keys (loto/barricades/extinguisher mirrored in the booleans above)
  precautionsJson  String?
  /// JSON array of PERMIT_PPE keys
  ppeJson          String?
  areaPhotoUrl     String?
  equipmentPhotoUrl String?
  completionPhotoUrl String?
  completionNotes  String?
  status           String       @default("sent") // sent|submitted|approved|completed|closed
  managerNotes     String?
  documentNumber   String?
  preWorkReceiverSigUrl    String?
  preWorkIssuerSigUrl      String?
  preWorkReceiverSignedAt  DateTime?
  preWorkIssuerSignedAt    DateTime?
  postWorkReceiverSigUrl   String?
  postWorkIssuerSigUrl     String?
  postWorkReceiverSignedAt DateTime?
  postWorkIssuerSignedAt   DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

// ——— Site Visitor ———
model VisitorSite {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  publicToken    String           @unique @default(cuid())
  protocolText   String
  createdAt      DateTime         @default(now())
  visitors       VisitorCheckIn[]
}

model VisitorCheckIn {
  id            String      @id @default(cuid())
  siteId        String
  site          VisitorSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  fullName      String
  company       String?
  hostName      String?
  registration  String?
  purpose       String
  phone         String
  photoUrl      String?
  signatureUrl  String?
  whatsappSent  Boolean     @default(true)
  deliveryLog   String?
  createdAt     DateTime    @default(now())
  /// Per-visit link sent on WhatsApp so the visitor can check themselves out
  checkoutToken String?     @default(cuid())
  checkedOutAt  DateTime?
  /// "Visitor" for self check-out, otherwise the staff member's name
  checkedOutBy  String?

  @@index([checkoutToken])
  @@index([siteId, checkedOutAt])
}

// ——— Asset Pre-Check ———
model Asset {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  assetCode      String
  publicToken    String           @unique @default(cuid())
  checklistJson  String           // JSON array of 5 checkpoint labels
  createdAt      DateTime         @default(now())
  checks         AssetPreCheck[]

  @@unique([organizationId, assetCode])
}

model AssetPreCheck {
  id            String   @id @default(cuid())
  assetId       String
  asset         Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  operatorName  String
  answersJson   String
  passToken     String   @unique @default(cuid())
  shiftDate     DateTime @default(now())
  createdAt     DateTime @default(now())
}

// ——— Near Miss ———
model NearMissBoard {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  publicToken    String       @unique @default(cuid())
  /// JSON array of area names offered on the public form
  locationsJson  String       @default("[]")
}

model NearMissReport {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reference          String?
  /// Lets the anonymous reporter follow progress without an account
  trackingToken      String?      @unique
  reportType         String       @default("near_miss") // see src/lib/modules/nearmiss-options.ts
  category           String?
  potentialSeverity  String?      // low|medium|high|critical
  description        String
  immediateAction    String?
  occurredAt         DateTime?
  /// Legacy single photo; new reports use photosJson
  photoUrl           String?
  photosJson         String       @default("[]")
  locationHint       String?
  reporterName       String?
  reporterContact    String?
  status             String       @default("open") // open|triaged|closed
  riskRating         String?      // low|medium|high|critical
  assignedTo         String?
  correctiveAction   String?
  dueDate            DateTime?
  feedback           String?
  triagedAt          DateTime?
  closedAt           DateTime?
  closedBy           String?
  closeOutNote       String?
  closeOutPhotosJson String       @default("[]")
  createdAt          DateTime     @default(now())

  @@index([organizationId, createdAt])
}

// ——— Contractor Safety File ———
model ContractorProfile {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyName    String
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  /// JSON array of item keys from src/lib/modules/safety-file-items.ts ("custom:<label>" for extras)
  requirementsJson String            @default("[]")
  publicToken    String              @unique @default(cuid())
  status         String              @default("pending") // pending|active|blocked
  createdAt      DateTime            @default(now())
  documents      ContractorDocument[]
}

model ContractorDocument {
  id           String            @id @default(cuid())
  contractorId String
  contractor   ContractorProfile @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  docType      String // requirement item key
  fileUrl      String
  fileName     String?
  mimeType     String?
  sizeBytes    Int?
  expiresAt    DateTime?
  uploadedAt   DateTime          @default(now())
}

// ——— OHSA Mock Auditor ———
model OhsaAudit {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  monthLabel     String
  /// Legacy 8-item checklist answers; new audits use OhsaAuditAnswer rows
  answersJson    String       @default("[]")
  /// Compliance %: yes / (yes + no)
  score          Float?
  status         String       @default("in_progress") // in_progress|completed
  auditorName    String?
  documentNumber String?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  answers        OhsaAuditAnswer[]
}

model OhsaAuditAnswer {
  id         String    @id @default(cuid())
  auditId    String
  audit      OhsaAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  /// Question id from src/lib/modules/ohsa-audit-items.ts, e.g. "1.1.2.c"
  questionId String
  answer     String?   // yes|no|na
  note       String?
  /// JSON array of /uploads/ohsa/<orgId>/... photo URLs
  photosJson String    @default("[]")
  updatedAt  DateTime  @updatedAt

  @@unique([auditId, questionId])
}

// ——— Leave Planner ———
model LeaveLevelRule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  levelName      String
  mode           String       // approve|auto|block
  blackoutJson   String       @default("[]") // ISO date strings

  @@unique([organizationId, levelName])
}

model LeaveRequest {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  publicToken    String       @unique @default(cuid())
  employeeName   String
  employeeLevel  String
  startDate      DateTime
  endDate        DateTime
  reason         String?
  status         String       @default("pending") // pending|approved|auto_approved|blocked|rejected|cancelled
  createdAt      DateTime     @default(now())
  employeeId     String?
  employee       LeaveEmployee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  leaveType      String       @default("annual")
  days           Float?       // working days deducted; null on legacy requests
  decidedAt      DateTime?
  decidedBy      String?
  decisionNote   String?
  cancelledAt    DateTime?
  capturedBy     String?      // set when an admin records leave on the employee's behalf

  @@index([employeeId])
}

model LeaveEmployee {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  publicToken    String       @default(cuid())
  fullName       String
  employeeNumber String?
  phone          String?
  level          String       @default("Staff")
  startDate      DateTime     // employment start; sick/family cycles run from here
  annualDays     Float        @default(15) // working days per year, accrued monthly
  balanceDate    DateTime     // opening balances are as at this date
  openingAnnual  Float        @default(0)
  openingSick    Float?       // null = full cycle entitlement
  openingFamily  Float?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  requests       LeaveRequest[]
  adjustments    LeaveAdjustment[]

  @@index([organizationId])
  @@index([publicToken])
}

model LeaveAdjustment {
  id         String        @id @default(cuid())
  employeeId String
  employee   LeaveEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType  String
  days       Float         // positive adds days, negative removes
  note       String?
  createdBy  String?
  createdAt  DateTime      @default(now())

  @@index([employeeId])
}

model LeaveSettings {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workDays       String       @default("12345") // ISO weekdays, 1 = Monday
  allowNegative  Boolean      @default(false)
}

// ——— Discipline ———
/// One disciplinary case: incident -> (hearing) -> sanction -> employee acknowledgement -> (appeal).
model DisciplineEntry {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reference         String?
  employeeName      String
  employeeNumber    String?
  employeePhone     String?
  jobTitle          String?
  department        String?
  /// Sanction: pending|counselling|verbal|written|final|dismissal|not_guilty (see discipline-options.ts)
  stage             String
  /// open|hearing|issued|finalised|withdrawn; legacy rows are finalised records
  status            String       @default("finalised")
  offenceKey        String?
  offence           String?
  offenceSeverity   String?      // minor|serious|dismissible
  /// Incident description
  notes             String
  location          String?
  witnesses         String?
  /// Legacy single photo; new cases use photosJson
  photoUrl          String?
  photosJson        String       @default("[]")
  incidentAt        DateTime
  hearingAt         DateTime?
  hearingVenue      String?
  chairperson       String?
  noticeIssuedAt    DateTime?
  noticeAckAt       DateTime?
  noticeAckSignature String?
  finding           String?      // guilty|not_guilty
  outcomeReasons    String?
  mitigating        String?
  aggravating       String?
  sanctionDate      DateTime?
  validUntil        DateTime?
  issuedBy          String?
  issuerSignature   String?
  /// Lets the employee view and sign the notice/outcome from a WhatsApp link
  signToken         String?      @unique
  employeeSignature String?
  employeeSignedAt  DateTime?
  employeeComment   String?
  refusedToSign     Boolean      @default(false)
  witnessName       String?
  witnessSignature  String?
  appealLodgedAt    DateTime?
  appealGrounds     String?
  appealOutcome     String?      // upheld|dismissed|varied
  appealNotes       String?
  appealDecidedAt   DateTime?
  withdrawnReason   String?
  createdAt         DateTime     @default(now())

  @@index([organizationId, incidentAt])
}

model DisciplineSettings {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  verbalMonths   Int          @default(3)
  writtenMonths  Int          @default(6)
  finalMonths    Int          @default(12)
  defaultIssuer  String?
}

// ——— Onboard Docs ———
model OnboardingPacket {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeName     String
  employeePhone    String?
  employeeEmail    String?
  employeeNumber   String?
  jobTitle         String?
  department       String?
  startDate        DateTime?
  publicToken      String       @unique @default(cuid())
  /// JSON array of item keys from src/lib/modules/onboard-items.ts ("custom:<label>" for extras)
  requirementsJson String       @default("[]")
  /// Legacy fixed uploads; new packets use OnboardingDocument rows
  idDocUrl         String?
  addressDocUrl    String?
  /// AES-256-GCM encrypted JSON (see onboard-server.ts)
  personalJson     String?
  bankJson         String?
  /// JSON array of { by, at } for every time bank details were revealed
  bankViewLog      String       @default("[]")
  consentName      String?
  consentSignature String?
  consentAt        DateTime?
  /// sent|in_progress|submitted|changes_requested|approved (legacy: completed)
  status           String       @default("sent")
  reviewNote       String?
  submittedAt      DateTime?
  reviewedAt       DateTime?
  reviewedBy       String?
  leaveEmployeeId  String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  documents        OnboardingDocument[]
}

model OnboardingDocument {
  id         String           @id @default(cuid())
  packetId   String
  packet     OnboardingPacket @relation(fields: [packetId], references: [id], onDelete: Cascade)
  itemKey    String
  fileUrl    String
  fileName   String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime         @default(now())

  @@index([packetId])
}

// ——— Contract Sentinel ———
model ContractTemplate {
  id                 String             @id @default(cuid())
  organizationId     String
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  /// contract|policy|other
  category           String             @default("contract")
  /// text (bodyText with {{merge}} fields) | pdf (uploaded fileUrl)
  kind               String             @default("text")
  bodyText           String             @default("")
  fileUrl            String?
  fileName           String?
  pageCount          Int?
  requireCountersign Boolean            @default(false)
  /// Days the employee has to sign; null = no due date
  dueDays            Int?
  archived           Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  documents          ContractDocument[]

  @@index([organizationId])
}

model ContractDocument {
  id                 String            @id @default(cuid())
  organizationId     String
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templateId         String?
  template           ContractTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  reference          String?
  title              String
  /// Frozen copy of the text that was sent (merge fields already filled in)
  bodyText           String
  kind               String            @default("text")
  /// Original PDF for kind=pdf (shared with the template; never deleted while referenced)
  sourceFileUrl      String?
  pageCount          Int?
  /// SHA-256 of bodyText or of the source PDF, shown to the signer and on the certificate
  contentHash        String?
  publicToken        String            @unique @default(cuid())
  employeeName       String?
  /// Legacy free-text contact; new documents use employeePhone/employeeEmail
  employeeContact    String?
  employeePhone      String?
  employeeEmail      String?
  employeeNumber     String?
  jobTitle           String?
  batchId            String?
  dueDate            DateTime?
  requireCountersign Boolean           @default(false)
  sentBy             String?
  /// sent|viewed|awaiting_countersign|completed|declined|voided (legacy: signed)
  status             String            @default("sent")
  viewedAt           DateTime?
  viewIp             String?
  signerName         String?
  signerIdNumber     String?
  /// Legacy inline data URL; new signatures are stored at signatureUrl
  signatureData      String?
  signatureUrl       String?
  signIp             String?
  signUserAgent      String?
  signedAt           DateTime?
  declinedAt         DateTime?
  declineReason      String?
  voidedAt           DateTime?
  voidReason         String?
  countersignedAt    DateTime?
  countersignName    String?
  countersignUrl     String?
  signedPdfUrl       String?
  lastRemindedAt     DateTime?
  reminderCount      Int               @default(0)
  createdAt          DateTime          @default(now())

  @@index([organizationId])
}

// ——— Equipment ———
model EquipmentItem {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  assetTag       String?
  category       String           @default("other")
  serialNumber   String?
  value          Float?
  condition      String           @default("good") // new|good|fair|poor|damaged
  status         String           @default("available") // available|issued|repair|lost|retired
  location       String?
  notes          String?
  photoUrl       String?
  updatedAt      DateTime         @default(now()) @updatedAt
  createdAt      DateTime         @default(now())
  issues         EquipmentIssue[]

  @@index([organizationId])
}

/// One custody period: issued to a person, signed for, and (later) handed back and inspected.
model EquipmentIssue {
  id                 String        @id @default(cuid())
  organizationId     String
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId             String
  item               EquipmentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  batchId            String
  documentNumber     String
  publicToken        String        @unique
  employeeName       String
  employeeNumber     String?
  employeePhone      String?
  dueBackAt          DateTime?
  conditionOut       String
  accessories        String?
  notesOut           String?
  issuedBy           String?
  status             String        @default("awaiting_signature") // awaiting_signature|active|returned|lost|cancelled
  signMethod         String        @default("in_person") // in_person|link
  signerName         String?
  signatureUrl       String?
  signedAt           DateTime?
  signIp             String?
  lastRemindedAt     DateTime?
  reminderCount      Int           @default(0)
  returnBatchId      String?
  handbackNumber     String?
  returnedAt         DateTime?
  receivedBy         String?
  conditionIn        String?
  checklistJson      String?
  damageNotes        String?
  photosJson         String?
  repairCost         Float?
  outcome            String? // stock|repair|retired|lost
  employeePresent    Boolean       @default(true)
  returnSignerName   String?
  returnSignatureUrl String?
  inspectorSignature String?
  deductibleId       String?
  cancelReason       String?
  createdAt          DateTime      @default(now())

  @@index([organizationId])
  @@index([itemId])
  @@index([batchId])
}

/// Event trail per item (issue, handback, repair, edits).
model EquipmentCustodyLog {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId         String
  issueId        String?
  employeeName   String
  action         String // issue|signed|handback|lost|repair_done|cancelled|note
  by             String?
  signatureData  String?
  conditionNotes String?
  damagePhotoUrl String?
  createdAt      DateTime      @default(now())

  @@index([itemId])
}

// ——— Loan / Deductible ———
model LoanDeductibleRecord {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  publicToken    String       @unique @default(cuid())
  employeeName   String
  employeeNumber String?
  recordType     String // loan|deductible
  amount         Float
  description    String
  repaymentNote  String?
  photoUrl       String?
  signatureData  String?
  status         String       @default("pending")
  signedAt       DateTime?
  createdAt      DateTime     @default(now())
}

// ——— Job Cards ———
model JobCard {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mode           String // internal|field
  jobNumber      String?
  title          String
  machineRef     String?
  location       String?
  priority       String       @default("normal") // low|normal|urgent
  publicToken    String       @unique @default(cuid())
  description    String?
  status         String       @default("open") // open|scheduled|in_progress|awaiting_signoff|done
  reportedByName String?
  reportedByPhone String?
  openComment    String?
  openSignature  String?
  openSignedAt   DateTime?
  photosJson     String? // [{url, side: open|work}]
  mechanicName   String?
  workComment    String?
  technicianSignature String?
  technicianSignedAt DateTime?
  downtimeHours  Float?
  partsCost      Float?
  partsJson      String? // [{name,qty,cost}]
  hoursWorked    Float?
  clientName     String?
  clientSignature String?
  acceptComment  String?
  acceptedAt     DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ——— Workshop Stock ———
model StockItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  sku            String?
  unit           String       @default("each")
  location       String?
  supplier       String?
  quantity       Int          @default(0)
  reorderAt      Int          @default(5)
  publicToken    String       @unique @default(cuid())
  createdAt      DateTime     @default(now())
  movements      StockMovement[]
}

model StockMovement {
  id                String    @id @default(cuid())
  itemId            String
  item              StockItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  kind              String    @default("legacy") // issue|receive|return|adjust|legacy
  quantity          Int       @default(0)
  delta             Int
  balanceAfter      Int?
  partyName         String?
  partySignature    String?
  loggedByName      String?
  loggedBySignature String?
  jobRef            String?
  note              String?
  reason            String?
  createdAt         DateTime  @default(now())

  @@index([itemId])
}

// ——— Pre-Trip / Handover ———
model Vehicle {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                 String
  regNumber            String
  make                 String?
  licenceDiscNo        String?
  licenceDiscExpires   String?
  licenceDiscPhotoUrl  String?
  insurer              String?
  insurancePolicyNo    String?
  insuranceExpires     String?
  insurancePhotoUrl    String?
  roadworthyNo         String?
  roadworthyExpires    String?
  roadworthyPhotoUrl   String?
  publicToken          String            @unique @default(cuid())
  createdAt      DateTime          @default(now())
  trips          VehicleTripLog[]
}

model VehicleTripLog {
  id                     String    @id @default(cuid())
  vehicleId              String
  vehicle                Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverName             String
  licenceNo              String?
  site                   String?
  startKm                Int
  endKm                  Int?
  endDriverName          String?
  checklistJson          String
  faultNote              String?
  photoUrlsJson          String?
  driverSignature        String?
  endSignature           String?
  endNote                String?
  handoverFrom           String?
  handoverTo             String?
  handoverFromSignature  String?
  handoverToSignature    String?
  handoverKm             Int?
  handoverNote           String?
  handoverAt             DateTime?
  endedAt                DateTime?
  varianceFlag           Boolean   @default(false)
  createdAt              DateTime  @default(now())

  @@index([vehicleId])
}

// ——— Meter Variance ———
model MeterSite {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  meterType      String // water|electricity
  meterNumber    String?
  accountNumber  String?
  municipality   String?
  location       String?
  unit           String         @default("kL")
  alertThreshold Float          @default(1.5) // multiplier vs baseline
  alertPhone     String?
  publicToken    String         @unique @default(cuid())
  createdAt      DateTime       @default(now())
  readings       MeterReading[]
}

model MeterReading {
  id               String    @id @default(cuid())
  siteId           String
  site             MeterSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  reading          Float
  occupancy        Int       @default(0)
  alerted          Boolean   @default(false)
  readerName       String    @default("")
  readerSignature  String?
  photoUrl         String?
  extraPhotoUrl    String?
  note             String?
  previousReading  Float?
  usage            Float?
  baseline         Float?
  varianceNote     String?
  checkedByName    String?
  checkedSignature String?
  checkedAt        DateTime?
  checkNote        String?
  checkPhotoUrl    String?
  createdAt        DateTime  @default(now())

  @@index([siteId])
}

// ——— Digital OB ———
model ObSite {
  id             String    @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  location       String?
  publicToken    String    @unique @default(cuid())
  wakeMinutes    Int       @default(60)
  guardPhone     String?
  controlPhone   String?
  createdAt      DateTime  @default(now())
  entries        ObEntry[]
}

model ObEntry {
  id                   String   @id @default(cuid())
  siteId               String
  site                 ObSite   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  entryNumber          String   @default("")
  category             String
  notes                String?
  people               String?
  actionTaken          String?
  guardName            String   @default("")
  guardSignature       String?
  photoUrl             String?
  extraPhotoUrl        String?
  handoverToName       String?
  handoverToSignature  String?
  lat                  Float?
  lng                  Float?
  createdAt            DateTime @default(now())

  @@index([siteId])
}

// ——— Fit for Duty ———
model FitForDutySite {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  location       String?
  publicToken    String              @unique @default(cuid())
  createdAt      DateTime            @default(now())
  checks         FitForDutyCheck[]
}

model FitForDutyCheck {
  id             String         @id @default(cuid())
  siteId         String
  site           FitForDutySite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  employeeName   String
  employeeNumber String?
  reactionMs     Int
  ppeConfirmed   Boolean
  ppeJson        String?
  photoUrl       String?
  signatureUrl   String?
  note           String?
  status         String // VERIFIED_READY|FAILED|SKIPPED
  createdAt      DateTime       @default(now())

  @@index([siteId])
}

// ——— Quotations and invoicing ———
model BillingProfile {
  id                 String       @id @default(cuid())
  organizationId     String       @unique
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  legalName          String
  tradingName        String?
  registrationNumber String?
  vatRegistered      Boolean      @default(false)
  vatNumber          String?
  vatPercent         Float        @default(15)
  address            String?
  email              String?
  phone              String?
  bankName           String?
  accountName        String?
  accountNumber      String?
  branchCode         String?
  accountType        String?
  defaultCurrency    String       @default("ZAR")
  paymentTermsDays   Int          @default(30)
  quoteValidDays     Int          @default(14)
  terms              String?
  footerNote         String?
  updatedAt          DateTime     @updatedAt
}

model BillingTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  notes          String?
  terms          String?
  linesJson      String
  createdAt      DateTime     @default(now())

  @@unique([organizationId, name])
}

model BillingDocument {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind             String
  number           String
  status           String
  templateName     String?
  currency         String
  chargeVat        Boolean      @default(false)
  vatPercent       Float        @default(0)
  clientName       String
  clientCompany    String?
  clientEmail      String?
  clientPhone      String?
  clientAddress    String?
  clientVatNumber  String?
  issueDate        String
  dueDate          String?
  theirReference   String?
  notes            String?
  terms            String?
  linesJson        String
  subtotalCents    Int
  vatCents         Int
  totalCents       Int
  paidOn           String?
  paymentMethod    String?
  paymentReference String?
  sourceQuoteId    String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organizationId, number])
  @@index([organizationId])
}

// ——— Payroll ———
model PayrollProfile {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payeNumber     String?
  uifNumber      String?
  sdlNumber      String?
  paySdl         Boolean      @default(false)
  payDay         Int          @default(25)
  updatedAt      DateTime     @updatedAt
}

model PayrollEmployee {
  id                    String          @id @default(cuid())
  organizationId        String
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fullName              String
  employeeNumber        String?
  idNumber              String?
  taxNumber             String?
  dateOfBirth           String?
  startDate             String?
  jobTitle              String?
  email                 String?
  phone                 String?
  bankName              String?
  accountNumber         String?
  branchCode            String?
  accountType           String?
  monthlySalaryCents    Int             @default(0)
  allowanceCents        Int             @default(0)
  pensionCents          Int             @default(0)
  employerPensionCents  Int             @default(0)
  medicalMember         Boolean         @default(false)
  medicalDependants     Int             @default(0)
  medicalDeductionCents Int             @default(0)
  paysUif               Boolean         @default(true)
  active                Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  lines                 PayrollLine[]

  @@index([organizationId])
}

model PayrollRun {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  period         String
  payDate        String
  status         String        @default("OPEN")
  finalisedAt    DateTime?
  createdAt      DateTime      @default(now())
  lines          PayrollLine[]

  @@unique([organizationId, period])
}

model PayrollLine {
  id                    String           @id @default(cuid())
  runId                 String
  run                   PayrollRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId            String?
  employee              PayrollEmployee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  fullName              String
  employeeNumber        String?
  idNumber              String?
  taxNumber             String?
  jobTitle              String?
  bankName              String?
  accountNumber         String?
  branchCode            String?
  basicCents            Int              @default(0)
  allowanceCents        Int              @default(0)
  onceOffCents          Int              @default(0)
  pensionCents          Int              @default(0)
  employerPensionCents  Int              @default(0)
  grossCents            Int              @default(0)
  taxableMonthlyCents   Int              @default(0)
  payeCents             Int              @default(0)
  uifEmployeeCents      Int              @default(0)
  uifEmployerCents      Int              @default(0)
  sdlCents              Int              @default(0)
  medicalCreditCents    Int              @default(0)
  medicalDeductionCents Int              @default(0)
  netCents              Int              @default(0)
  employerCostCents     Int              @default(0)
  ageAtYearEnd          Int?
  rebateLabel           String?
  note                  String?

  @@index([runId])
}

// ——— Site attendance ———
model AttendanceSite {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  location       String?
  publicToken    String             @unique @default(cuid())
  createdAt      DateTime           @default(now())
  punches        AttendancePunch[]
}

model AttendancePunch {
  id             String         @id @default(cuid())
  siteId         String
  site           AttendanceSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  direction      String
  fullName       String
  employeeNumber String?
  photoUrl       String
  signatureUrl   String
  note           String?
  createdAt      DateTime       @default(now())

  @@index([siteId])
}

// ——— Accident and injury ———
model AccidentReport {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportNumber      String
  occurredAt        String
  location          String
  injuredName       String
  employeeNumber    String?
  idNumber          String?
  jobTitle          String?
  activity          String
  description       String
  injury            String
  treatment         String?
  witnesses         String?
  actionTaken       String?
  photoUrl          String?
  extraPhotoUrl     String?
  reporterName      String
  reporterSignature String
  injuredSignature  String?
  witnessName       String?
  witnessSignature  String?
  createdAt         DateTime     @default(now())

  @@unique([organizationId, reportNumber])
  @@index([organizationId])
}

// ——— Training and tickets ———
model TrainingTicket {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fullName          String
  employeeNumber    String?
  ticketType        String
  certificateNumber String?
  provider          String?
  issuedOn          String
  expiresOn         String
  photoUrl          String?
  note              String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([organizationId])
}
